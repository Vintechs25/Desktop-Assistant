# =============================================================================
# Desktop Assistant — standalone pnpm / npm configuration
# =============================================================================
#
# This file applies when you install from INSIDE this directory:
#   cd artifacts/desktop-assistant
#   pnpm install          (or: npm install)
#
# It is intentionally isolated from the root pnpm-workspace.yaml overrides,
# which strip platform-specific binaries for the Replit Linux CI environment.
# Those overrides would remove esbuild's win32-x64 binary and rollup's
# win32-x64 binary, breaking electron-vite on Windows.
# =============================================================================

# Use the traditional flat node_modules layout instead of pnpm's virtual store.
# Required for:
#   • Native modules (better-sqlite3, tesseract.js) — node-gyp / node-pre-gyp
#     resolves .node binaries relative to node_modules, not symlinks.
#   • @electron/rebuild — needs to patch binaries directly in node_modules.
#   • electron-vite / vite — some internal plugins resolve modules by walking
#     the directory tree and get confused by pnpm's symlink structure.
node-linker=node-modules

# Hoist all packages to the root node_modules.
# Electron's renderer and main processes both walk up to find modules; without
# hoisting, some renderer imports (e.g. react, zustand) can fail at runtime.
shamefully-hoist=true

# Do not fail when a pnpm-workspace.yaml is found in a parent directory.
# This lets `pnpm install` work correctly when run from inside this package
# without being treated as a workspace-root operation.
ignore-workspace-root-check=true
